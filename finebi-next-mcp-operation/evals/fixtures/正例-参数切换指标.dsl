Chart.edit("近十二个月指标对比")
    .from(Query.from("组织日经营宽表")
        .filter("([日期] >= RELATIVE_DATE(-2, 'YEAR', 'SAME_DAY'))")
        .label("筛近两年")
        .groupBy("门店系统编码", dim("日期").date()).agg(sum("合同金额").as("营业额"), sum("营业额目标万元").as("营业额目标"), sum("客资量").as("客资量"), sum("客资量目标").as("客资量目标"), sum("签约客户数").as("签约客户数"), sum("签约客户数目标").as("签约客户数目标"))
        .label("门店日汇总")
        .formula("[营业额]/10000").replace("营业额")
        .label("营业额改万元")
        .formula("IF(@指标切换 = '营业额(万元)', [营业额], IF(@指标切换 = '客资量', [客资量], IF(@指标切换 = '签约客户数', [签约客户数], NULL)))").as("指标值")
        .label("按参数取指标值")
        .formula("IF(@指标切换 = '营业额(万元)', [营业额目标], IF(@指标切换 = '客资量', [客资量目标], IF(@指标切换 = '签约客户数', [签约客户数目标], NULL)))").as("指标目标")
        .label("按参数取指标目标")
        .samePeriod("日期", PeriodType.YEAR_SAME).partitionBy("门店系统编码").value("指标值").as("指标同期")
        .label("取去年同日")
        .filter("([日期] BETWEEN RELATIVE_DATE(-11, 'MONTH', 'PERIOD_START') AND '')")
        .label("留近12个月"))
    .y(bar(sum("指标值").as("本期")).style("cornerRadius", 0).style("labelStroke", "auto").style("size", 0.9).style("tooltip", true).style("strokeColor", ""))
    .y(bar(sum("指标同期").as("去年同期")).style("cornerRadius", 0).style("labelStroke", "auto").style("size", 0.9).style("tooltip", true).style("strokeColor", ""))
    .y(line(metric("目标达成率")).style("marker", true).style("labelStroke", "auto").style("label", true).encode("label", metric("目标达成率")).style("tooltip", true).style("strokeColor", "").rightAxis())
    .metric("目标达成率", "IF(SUM([指标目标]) = 0 , NULL, SUM([指标值])/SUM([指标目标]))")
    .numberFormat(sum("指标值"), NumberFormatConfig.number(0))
    .numberFormat(metric("目标达成率"), NumberFormatConfig.percentage(2))
    .colorMapping(dim("__metric_name__"), {"本期": "var(--fvs-theme-color-1-3)", "去年同期": "var(--fvs-theme-color-4-1)", "目标达成率": "var(--fvs-theme-color-1-2)"})
    .build()
