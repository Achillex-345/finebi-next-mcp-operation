// 来源：A-13 结构派目标达成图（反读定义）
Chart.from("子类别年度目标达成")
    .x(dim("年份"))
    .y(bar(sum("实际销售额").as("实际销售额")).style("color", "#1F3A5F").style("tooltip", true).style("strokeColor", ""))
    .y(bar(sum("销售额目标").as("销售额目标")).style("color", "#C9CCD1").style("size", 0.3).style("tooltip", true).style("strokeColor", ""))
    .y(line(metric("目标达成率")).style("marker", true).style("color", "#1F2937").style("label", true).encode("label", metric("目标达成率")).style("tooltip", true).style("strokeColor", "").rightAxis())
    .geomRelation(GeomRelation.OVERLAP)
    .sort(dim("年份"), SortOrder.ASC)
    .drill(dim("年份"), dim("类别"), dim("产品子类别"))
    .metric("目标达成率", "SUM([实际销售额])/SUM([销售额目标])")
    .numberFormat(sum("实际销售额").as("实际销售额"), NumberFormatConfig.number(0, NumLevel.TEN_THOUSAND, "元"))
    .numberFormat(metric("目标达成率"), NumberFormatConfig.percentage(1))
    .referenceLine(metric("目标达成率"), 1, "#28A745", "目标 100%")
    .referenceLine(metric("目标达成率"), 0.9, "#FFC107", "预警 90%")
    .build()
