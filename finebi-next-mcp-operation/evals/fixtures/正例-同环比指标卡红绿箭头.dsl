// 来源：A-13 结构派指标卡（Chart.edit 追加条件格式后的反读定义）
Chart.from(Query.from("订单新老客标记")
        .groupBy().agg(sum("销售额").filter("([年月] = @基准月份)").as("本月销售额"), sum("销售额").filter("([年月] = COMBINEDELTA(@基准月份, -1, \"M\"))").as("上月销售额"), sum("销售额").filter("([年月] = COMBINEDELTA(@基准月份, -12, \"M\"))").as("去年本月销售额"))
        .label("按基准月汇总")
        .formula("[本月销售额]/[上月销售额]-1").as("销售额环比")
        .label("销售额环比")
        .formula("[本月销售额]/[去年本月销售额]-1").as("销售额同比")
        .label("算同环比"))
    .mark(MarkType.TEXT)
    .style("size", 0.6)
    .encode("text", sum("本月销售额").as("本月销售额"), sum("销售额环比").as("销售额环比"), sum("销售额同比").as("销售额同比"))
    .style("textLayout", TextLayout.PRIMARY_SECONDARY_1_1)
    .style("fit", false)
    .legend(false)
    .numberFormat(sum("本月销售额").as("本月销售额"), NumberFormatConfig.number(1, NumLevel.TEN_THOUSAND, "元"))
    .numberFormat(sum("销售额环比").as("销售额环比"), NumberFormatConfig.percentage(1))
    .conditionalFormat(sum("销售额环比").as("销售额环比"), "[销售额环比] < 0", "#D03B3B", IconShape.ARROWS_DOWN, "#D03B3B")
    .conditionalFormat(sum("销售额环比").as("销售额环比"), "[销售额环比] >= 0", "#0CA30C", IconShape.ARROWS_UP, "#0CA30C")
    .numberFormat(sum("销售额同比").as("销售额同比"), NumberFormatConfig.percentage(1))
    .conditionalFormat(sum("销售额同比").as("销售额同比"), "[销售额同比] < 0", "#D03B3B", IconShape.ARROWS_DOWN, "#D03B3B")
    .conditionalFormat(sum("销售额同比").as("销售额同比"), "[销售额同比] >= 0", "#0CA30C", IconShape.ARROWS_UP, "#0CA30C")
    .build()
